@page "/"
@rendermode InteractiveServer
@inject ICameraDataService CameraDataService
@inject ICustomLogger Logger
@using TechnicalInterView.Components.Pages
@using TechnicalInterView.Tenants.Models
<div class="container vh-100 overflow-y-hidden">
    <h2>Tenant Cameras</h2>
    <div class="container vh-20">
    <InputSelectorTenant 
        Tenants="@TenantList"
        @bind-Value="CurrentTenantId"/>
    </div>
    <hr/>
    <div class="container overflow-y-auto vh-80">

        <CameraGrid 
            TenantId="@CurrentTenantId"/>
    </div>
</div>


