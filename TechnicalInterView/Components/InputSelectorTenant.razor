@using TechnicalInterView.Tenants.Models
<select class="form-control" @onchange="HandleChange" value="@Value">
    <option value="">Select a tenant</option>
    @if (Tenants != null)
    {
        @foreach (var tenant in Tenants)
        {
            <option value="@tenant.Id">@tenant.Id</option>
        }
    }
</select>

@code {
    [Parameter] public List<Tenant> Tenants { get; set; } = new();

    [Parameter] public string Value { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    private async Task HandleChange(ChangeEventArgs e)
    {
        var selectedValue = e.Value?.ToString();
        await ValueChanged.InvokeAsync(selectedValue);
    }

}
