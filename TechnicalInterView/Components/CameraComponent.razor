@using TechnicalInterView.Cameras.Models

@if (asTableRow)
{
    @if (CameraModel is null)
    {
        <tr>
            <td colspan="4" class="text-center">No camera data available</td>
        </tr>
    }
    else
    {
        <tr>
            <td>@CameraModel?.Name</td>
            <td>@CameraModel?.UseCase</td>
            <td>
                <button type="button" class="@GetStatusClass()">
                    @CameraModel?.Status
                </button>
            </td>
            <td>
                <button type="submit">
                    Action
                </button>
            </td>
        </tr>
    }
}
else
{
    <div class="="d-flex justify-content-evenly">
        @CameraModel.?CameraId
        @CameraModel?.TenantId
        @CameraModel?.Name
        @CameraModel?.UseCase
        <button type="button" class="@GetStatusClass()">
            @CameraModel?.Status
        </button>
    </div>

}
